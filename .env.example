# AIShell environment variables
# Copy to .env.local for local overrides (optional — most settings use defaults).

# Operating mode: "standalone" (single user, no login) or "server" (multi-user auth)
AISHELL_MODE=standalone

# Express API port (default: 5175)
# AISHELL_PORT=5175

# Persistent data directory for config, secrets, and auth (default: ~/.aishell)
# AISHELL_DATA_DIR=/home/node/.aishell

# Required on first boot in server mode — creates the aishell_admin user
# AISHELL_ADMIN_PASSWORD=

# Global secret overrides (env vars take priority over encrypted file backend)
# AISHELL_SECRET_<KEY>=

# App-scoped secret overrides (app ID and key are uppercased, non-alphanumeric → _)
# AISHELL_SECRET_CODASCOPE_CURSOR_API_KEY=
# AISHELL_SECRET_CODASCOPE_CODASCOPE_PROJECTS_ROOT=/workspaces/codascope_projects
